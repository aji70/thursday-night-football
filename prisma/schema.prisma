generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  players   Player[]
}

model Player {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  passwordHash String
  status       String       @default("pending") // pending | active
  seat         String       @default("sub") // permanent | sub
  isAdmin      Boolean      @default(false)
  teamId       String?
  team         Team?        @relation(fields: [teamId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  payments     Payment[]
  events       MatchEvent[]
  feedback     Feedback[]

  @@index([name])
  @@index([status])
}

model Payment {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthKey  String // e.g. 2026-09-cycle
  type      String // MONTHLY_5K | MONTHLY_INSTALMENT | VISITOR_1_5K
  amount    Int
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([monthKey])
  @@index([playerId])
}

model MatchEvent {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthKey  String
  week      Int
  match     Int
  type      String // GOAL | ASSIST | YC | RC
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([monthKey])
  @@index([playerId])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Int
  note      String?
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

model PurseLedger {
  id        String   @id @default(cuid())
  kind      String // CARRYOVER | ADJUSTMENT
  title     String
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  type      String // suggestion | complaint
  message   String
  name      String?
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  status    String   @default("new") // new | read | resolved
  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
}
