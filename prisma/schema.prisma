generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  players      Player[]
  homeResults  MatchResult[] @relation("HomeTeam")
  awayResults  MatchResult[] @relation("AwayTeam")
}

model Player {
  id                          String       @id @default(cuid())
  name                        String
  phone                       String       @unique
  passwordHash                String
  status                      String       @default("pending") // pending | active
  seat                        String       @default("sub") // permanent | sub
  isAdmin                     Boolean      @default(false)
  photoPath                   String?
  suspensionMatchesRemaining  Int          @default(0)
  suspensionReason            String?
  /** Admin-set attributes 0–99 (0 = not rated). Overall = avg of set ratings. */
  attack                      Int          @default(0)
  midfield                    Int          @default(0)
  defending                   Int          @default(0)
  teamId                      String?
  team                        Team?        @relation(fields: [teamId], references: [id])
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  payments                    Payment[]
  events                      MatchEvent[]
  feedback                    Feedback[]

  @@index([name])
  @@index([status])
}

model Payment {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthKey  String
  type      String // MONTHLY_5K | MONTHLY_INSTALMENT | VISITOR_1_5K
  amount    Int
  note      String?
  /** confirmed = admin-verified (counts in purse); claimed = player submitted, awaiting confirmation */
  status    String   @default("confirmed") // claimed | confirmed
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([monthKey])
  @@index([playerId])
  @@index([status])
}

/** Cash / on-field payments from people not yet registered. */
model WalkInPayment {
  id        String   @id @default(cuid())
  name      String
  amount    Int
  monthKey  String
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([monthKey])
}

model MatchEvent {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  monthKey  String
  week      Int
  match     Int
  type      String
  count     Int      @default(1)
  createdAt DateTime @default(now())

  @@index([monthKey])
  @@index([playerId])
}

/** Final score for a scheduled fixture (league table). */
model MatchResult {
  id         String   @id @default(cuid())
  monthKey   String
  week       Int
  match      Int
  homeTeamId String
  awayTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeGoals  Int
  awayGoals  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([monthKey, week, match])
  @@index([monthKey])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amount    Int
  note      String?
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

model PurseLedger {
  id        String   @id @default(cuid())
  kind      String
  title     String
  amount    Int
  note      String?
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  type      String
  message   String
  name      String?
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([type])
}
